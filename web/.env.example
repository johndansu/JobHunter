# Local Postgres from docker-compose.yml (port 5440 avoids clashes with other projects)
DATABASE_URL=postgres://jobhunter:jobhunter@localhost:5440/jobhunter

# Default viewer location for eligibility verdicts (ISO 3166-1 alpha-2 + IANA zone)
DEFAULT_COUNTRY=NG
DEFAULT_TIMEZONE=Africa/Lagos

# Optional: free Himalayas developer key (60 req/min, 10,000/day). Leave empty to use the shared public allowance.
HIMALAYAS_API_KEY=

# Claude models for the AI features (Phase 2+). Precise = CV parsing, drafting, truth check; bulk = job extraction and grading.
CLAUDE_MODEL_PRECISE=claude-opus-5-5
CLAUDE_MODEL_BULK=claude-sonnet-5-5

# What outgoing requests say about this app. No personal details.
USER_AGENT=JobHunter/2.0

# Pull jobs in the background while the app runs (local use). Set to "off" to only ingest via `npm run ingest`.
INGEST_SCHEDULER=on

# Needed to call POST /api/ingest when not on localhost
INGEST_SECRET=
